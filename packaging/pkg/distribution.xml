<?xml version="1.0" encoding="utf-8"?>
<!-- LIGHT SEEKER.pkg (scripts/build-pkg.sh fills in @VERSION@). Installs system-wide, for all users. -->
<installer-gui-script minSpecVersion="2">
    <title>LIGHT SEEKER</title>
    <organization>com.windwardaudio</organization>
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <domains enable_localSystem="true" enable_anywhere="false" enable_currentUserHome="false"/>
    <options customize="allow" rootVolumeOnly="true" hostArchitectures="arm64,x86_64"/>
    <volume-check>
        <allowed-os-versions>
            <os-version min="10.15"/>
        </allowed-os-versions>
    </volume-check>
    <choices-outline>
        <line choice="prepare"/>
        <line choice="au"/>
        <line choice="vst3"/>
    </choices-outline>
    <choice id="prepare" visible="false" title="Prepare installation">
        <pkg-ref id="com.windwardaudio.lightseeker.pkg.prepare"/>
    </choice>
    <choice id="au" title="Audio Units (GarageBand, Logic Pro)"
            description="LIGHT SEEKER and LIGHT SEEKER FX as Audio Units, in /Library/Audio/Plug-Ins/Components.">
        <pkg-ref id="com.windwardaudio.lightseeker.pkg.au"/>
    </choice>
    <choice id="vst3" title="VST3 (Ableton Live, Cubase, Reaper, Bitwig, ...)"
            description="LIGHT SEEKER and LIGHT SEEKER FX as VST3 plug-ins, in /Library/Audio/Plug-Ins/VST3.">
        <pkg-ref id="com.windwardaudio.lightseeker.pkg.vst3"/>
    </choice>
    <pkg-ref id="com.windwardaudio.lightseeker.pkg.prepare" version="@VERSION@" onConclusion="none">prepare.pkg</pkg-ref>
    <pkg-ref id="com.windwardaudio.lightseeker.pkg.au" version="@VERSION@" onConclusion="none">au.pkg</pkg-ref>
    <pkg-ref id="com.windwardaudio.lightseeker.pkg.vst3" version="@VERSION@" onConclusion="none">vst3.pkg</pkg-ref>
</installer-gui-script>
